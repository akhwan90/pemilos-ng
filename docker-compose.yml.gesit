version: '3.8'

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: gesit-app:latest
    container_name: gesit_app
    restart: unless-stopped
    ports:
      - "${APP_PORT:-8000}:80"
    environment:
      # Database Connection (Uses external MySQL container or the one below)
      DB_CONNECTION: mysql
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: ${DB_DATABASE:-db_gesit}
      DB_USERNAME: ${DB_USERNAME:-root}
      DB_PASSWORD: ${DB_PASSWORD:-root}
      # App Settings
      APP_NAME: GESIT
      APP_ENV: production
      APP_DEBUG: "false"
      APP_URL: "http://localhost:8000"
      LOG_CHANNEL: stderr
      CACHE_STORE: database
      SESSION_DRIVER: database
      QUEUE_CONNECTION: database
    volumes:
      - ./storage/app/public:/var/www/html/storage/app/public # Persist user uploads
    depends_on:
      db:
        condition: service_healthy

  db:
    image: mariadb:10.11
    container_name: gesit_db
    restart: unless-stopped
    ports:
      - "3306:3306"
    environment:
      MARIADB_DATABASE: ${DB_DATABASE:-db_gesit}
      MARIADB_ROOT_PASSWORD: ${DB_PASSWORD:-root}
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 3

volumes:
  db-data: